# Renombra este fichero a secrets.toml y rellena los valores.
# NUNCA subas secrets.toml al repositorio.
#
# Cómo obtener client_id / client_secret:
#   GCP Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   Application type: Web application
#   Authorized redirect URIs: https://<tu-dominio>/oauth2/callback
#   Consent screen: External (IMPORTANTE para admitir @abahana.com + @inferia.io)

[auth]
redirect_uri       = "https://<URL_CLOUD_RUN>/oauth2/callback"
cookie_secret      = "<cadena-aleatoria-32-chars>"  # genera con: python -c "import secrets; print(secrets.token_hex(16))"

[auth.google]
client_id     = "xxxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
